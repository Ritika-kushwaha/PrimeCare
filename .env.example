PORT=5000
NODE_ENV=development

# ── PostgreSQL Database ─────────────────────────────────────────────────
# Local: postgresql://postgres:<password>@localhost:5432/healthcare
# Render/Railway: copy from your hosted DB dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare"

# ── Authentication ──────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────
# Create a Gmail App Password: Google Account > Security > 2-Step > App Passwords
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Used by Next.js frontend API routes
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"

# ── Google AI (Gemini) ──────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# ── Google Calendar OAuth 2.0 ───────────────────────────────────────────
# Create OAuth credentials: console.cloud.google.com > APIs & Services > Credentials
# Enable: Google Calendar API
# Authorized redirect URI: http://localhost:5000/api/oauth/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:5000/api/oauth/callback"

# ── Redis (for slot hold mechanism) ────────────────────────────────────
# Local: redis://localhost:6379
# Upstash/Railway: copy from dashboard
REDIS_URL="redis://localhost:6379"

# ── Next.js Frontend (client/.env.local) ───────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:5000"

# ── Frontend URL (for CORS in Express) ─────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── Vercel Cron (optional, for medication reminders) ───────────────────
# Add to vercel.json: { "crons": [{ "path": "/api/cron/medication-reminders", "schedule": "0 * * * *" }] }
CRON_SECRET="your-cron-secret-token"
